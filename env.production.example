# ============================================================
# Variables de entorno — Assets Golden (Producción)
# ============================================================
# Copiar este archivo, rellenar los valores reales y añadir
# como variables de entorno en Vercel (Settings → Environment Variables)
# NUNCA commitear el archivo con valores reales.
# ============================================================

# Supabase — proyecto de producción
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# n8n — webhook de automatización de leads
N8N_WEBHOOK_URL=

# Resend — email transaccional
RESEND_API_KEY=

# URL pública del sitio (sin trailing slash)
NEXT_PUBLIC_SITE_URL=https://assetsgolden.com
